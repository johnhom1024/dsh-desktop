{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Electron host for DeepSeek Harness. Does not fork the official repo.",
  "author": "johnhom <924358746@qq.com>",
  "type": "module",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@8.11.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-preload.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "tsx --test src/main/*.test.ts src/i18n/*.test.ts && vitest run",
    "dist:mac": "pnpm run build:main && pnpm run build:renderer && node scripts/write-icon.mjs && pnpm exec electron-builder --mac dmg --arm64 --publish never && node scripts/sha256-release.mjs release arm64",
    "dist:mac:intel": "pnpm run build:main && pnpm run build:renderer && node scripts/write-icon.mjs && pnpm exec electron-builder --mac dmg --x64 --publish never && node scripts/sha256-release.mjs release x64"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
