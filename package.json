{
  "name": "dsh-app",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Electron host for DeepSeek Harness. Does not fork the official repo.",
  "type": "module",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@8.11.0",
  "scripts": {
    "dev": "pnpm run build:main && cross-env NODE_ENV=development pnpm exec electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/main/*.test.ts"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
